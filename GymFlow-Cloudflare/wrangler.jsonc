{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gymflow",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-07-24",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gymflow-db",
      "database_id": "10fcc454-c6d7-440a-9087-6e99bcb87fdb"
    }
  ],
  "observability": {
    "enabled": true
  }
}
